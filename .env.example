# ── LLM ─────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gpt-oss-120b

# ── Qdrant ───────────────────────────────────────
QDRANT_USE_LOCAL=true
QDRANT_PATH=./qdrant_storage
# (only used when QDRANT_USE_LOCAL=false)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
COLLECTION_NAME=core_rag_collection

# ── Embeddings ───────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_SIZE=384

# ── Chunking ─────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval ────────────────────────────────────
TOP_K=10
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_LENGTH=3000

# ── App ──────────────────────────────────────────
DEBUG=false
APP_TITLE=RAG Backend API
APP_VERSION=1.0.0
